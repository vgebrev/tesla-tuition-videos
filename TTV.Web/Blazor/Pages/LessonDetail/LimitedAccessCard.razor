@using System.Security.Claims;
@using TTV.Web.Shared;
<LessonOwnView Lesson="Lesson">
    <NotOwned>
        <div class="card border-warning mb-3">
            <div class="card-body pb-2 d-flex align-items-baseline">
                <p class="card-text me-3">Limited access. Please purchase the lesson for full access. </p>
                <BuyNowButton Lesson="Lesson" class="btn btn-outline-warning"></BuyNowButton>
                <AuthorizeView>
                    <NotAuthorized>
                        <p class="card-text ms-3">If you have already purchased the lesson, please <LogInLink class="text-warning">Log in</LogInLink>.</p>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </NotOwned>
</LessonOwnView>

@code {
    [Parameter]
    public LessonDto Lesson { get; set; } = new();
}
