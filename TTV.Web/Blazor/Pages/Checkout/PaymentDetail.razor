@inject IJSRuntime JS
@implements IAsyncDisposable
@attribute [Authorize]

@using Fluxor;
@using Microsoft.AspNetCore.Authorization
@using TTV.Web.Blazor.Pages.Checkout.Store;
@using TTV.Web.Blazor.Pages.Checkout.Store.Actions;
@using TTV.Web.Shared

@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IState<CheckoutState> State
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager

<div class="card bg-secondary">
    <div class="card-header">Payment Details</div>
    <div class="card-body">
        <h4>Payment Method</h4>
        <EditForm Model="paymentMethod">
            <div class="row">
                <InputRadioGroup @bind-Value="paymentMethod">
                    <div class="col-12 col-md-4 mb-2">
                        <div class="form-check disabled">
                            <InputRadio class="form-check-input" id="payfast" Value="PaymentMethod.Payfast" />
                            <label class="form-check-label" for="payfast">
                                <i class="bi bi-credit-card"></i> Payfast
                            </label>
                        </div>
                    </div>
                    <div class="col-12 col-md-4 mb-2">
                        <div class="form-check">
                            <InputRadio class="form-check-input" id="eft" Value="PaymentMethod.BankTransfer" />
                            <label class="form-check-label" for="eft">
                                <i class="bi bi-bank"></i> Bank Transfer
                            </label>
                        </div>
                    </div>
                    <div class="col-12 col-md-4 mb-2">
                        <div class="form-check disabled">
                            <InputRadio class="form-check-input" id="paypal" Value="PaymentMethod.PayPal" disabled />
                            <label class="form-check-label" for="paypal">
                                <i class="bi bi-paypal"></i> PayPal <span class="text-muted">(Coming Soon)</span>
                            </label>
                        </div>
                    </div>
                </InputRadioGroup>
            </div>
        </EditForm>

    </div>
    <div class="card-footer">
        <div class="row justify-content-center">
            @if (Order.CanComplete)
            {
                <div class="col-12 col-sm-6 col-md-4 text-center mb-2">
                    <button type="button" class="btn btn-primary btn-lg" @onclick="CompleteOrder"><i class="bi bi-hand-thumbs-up me-2"></i> Complete</button>
                </div>
            }

            @if (Order.IsPayable)
            {
                <div class="col-12 col-sm-6 col-md-4 text-center mb-2">
                    <button type="button" class="btn btn-primary btn-lg" @onclick="OrderPayment"><i class="bi bi-credit-card me-2"></i> Pay Now</button>
                </div>
            }
        </div>

        <div class="row">
            @if (!Order.CanComplete && !Order.IsPayable)
            {
                <div class="col-12">
                    @if (Order.HasOwnedLessons)
                    {
                        <div class="card border-danger mb-2">
                            <div class="card-body">
                                You already own one or more of the lessons in this order.
                            </div>
                        </div>
                    }
                    @if (Order.IsFinalised)
                    {
                        <div class="card border-danger">
                            <div class="card-body">
                                The order already has a status of "@Order.Status.Name"
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<Modal IsOpen="IsEftModalOpen">
    <PayByBankTransfer OrderId="@Order.Id"></PayByBankTransfer>
</Modal>

@code {
    [Parameter]
    public OrderDto Order { get; set; } = new();

    private ResultDto<PaymentDto?>? InitiatePaymentResult => State.Value.InitiatePaymentResult;
    private PaymentDto? LatestPayment => InitiatePaymentResult?.Value;
    private bool IsEftModalOpen => LatestPayment != null && LatestPayment.PaymentMethod == PaymentMethod.BankTransfer && LatestPayment.PaymentMethod == paymentMethod;
    private PaymentMethod paymentMethod = PaymentMethod.Payfast;

    private IJSObjectReference? script;

    protected override void OnInitialized()
    {
        SubscribeToAction<InitiatePaymentResponse>(async (response) =>
        {
            if (response.Result.IsSuccess && response.Result.Value != null && response.Result.Value.PaymentMethod == PaymentMethod.Payfast && script != null)
            {
                var returnUrl = NavigationManager.ToAbsoluteUri($"/order-complete/{Order.Id}").ToString();
                var cancelUrl = NavigationManager.ToAbsoluteUri($"/payment-cancel/{Order.Id}").ToString();
                await script.InvokeVoidAsync("payfastModal", response.Result.Value.ExternalIdentifier, returnUrl, cancelUrl);
            }
        });

        base.OnInitialized();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && script == null)
        {
            script = await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Checkout/PaymentDetail.razor.js");
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    protected override async ValueTask DisposeAsyncCore(bool disposing)
    {
        if (script != null && disposing)
        {
            await script.DisposeAsync();
        }
        await base.DisposeAsyncCore(disposing);
    }

    private void CompleteOrder()
    {
        NavigationManager.NavigateTo($"/order-complete/{Order.Id}");
    }

    private void OrderPayment()
    {
        Dispatcher.Dispatch(new InitiatePaymentRequest() { OrderId = Order.Id, PaymentMethod = paymentMethod });
    }
}
