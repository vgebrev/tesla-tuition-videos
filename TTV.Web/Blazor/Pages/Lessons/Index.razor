@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@page "/lessons"
@using Fluxor;
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication;
@using TTV.Web.Blazor.Store.Lessons;
@using TTV.Web.Blazor.Store.Lessons.Actions;
@using TTV.Web.Shared;

<PageTitle>Tesla Tuition Videos - Lessons</PageTitle>

<div class="row justify-content-center">
    <div class="col text-center">
        <h1 class="header-white">Lessons</h1>
    </div>
</div>

<div class="row">
    <div class="col-3">
        <TagFilter></TagFilter>
    </div>
    <div class="col">
        <div class="row">
            <div class="col-12">
                <LessonSearch></LessonSearch>
            </div>
        </div>
        <div class="row">
            <div class="col-12 my-1 min-height-16">
                <ProgressLoader IsLoading="LessonsState.Value.IsLoadingLessons"></ProgressLoader>
            </div>
        </div>
        @if (LessonsState.Value.LessonsError.IsError)
        {
            <div class="row">
                <div class="col-7 mb-3 mx-auto">
                    <ErrorCard Error="LessonsState.Value.LessonsError"></ErrorCard>
                </div>
            </div>
        }

        @if (LessonsState.Value.Lessons != null)
        {
            @if (LessonsState.Value.Lessons.Length > 0)
            {
                <div class="row row-cols-2 g-3">

                    @foreach (var lesson in LessonsState.Value.Lessons)
                    {
                        <div class="col">
                            <LessonCard Lesson="lesson"></LessonCard>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col text-center">
                        No lessons match your search.
                        <p class="text-muted">Please try again with different search terms or filters.</p>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    [Inject]
    private IState<LessonsState> LessonsState { get; set; } = default!;
    [Inject]
    private IDispatcher Dispatcher { get; set; } = default!;

    private bool IsLoading => LessonsState.Value.IsLoadingLessons;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (LessonsState.Value.Lessons == null)
        {
            Dispatcher.Dispatch(new SearchLessonsRequest() { SearchText = LessonsState.Value.SearchText, SearchTags = LessonsState.Value.SearchTags });
        }
    }
}
