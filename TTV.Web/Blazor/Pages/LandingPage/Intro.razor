@inject IJSRuntime JSRuntime

<div class="h-100 w-100 position-relative">
    <div class="intro-video-container w-100 h-100">
        <video autoplay muted id="intro-video">
            <source src="assets/video/intro.mp4" type="video/mp4">
        </video>
    </div>
    <div class="d-flex flex-column justify-content-between p-5 h-100 w-100 position-absolute top-0 start-0">
        <div>
            <h1 @ref="headerElem" class="fade-in header-white">Master Physical Science</h1>
            <h3 class="">High-quality, comprehensive videos for high school students</h3>
        </div>
        <div class="d-flex flex-column align-items-center w-100 gap-5">
            <h3>Where science comes alive!</h3>
            <a href="lessons" class="btn btn-lg btn-outline-primary p-5 flex-fill">Browse Lessons</a>
        </div>
    </div>
</div>

@code {
    private ElementReference headerElem;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initLandingVideo", "intro-video");
            await JSRuntime.InvokeVoidAsync("initIntersectionObserver", headerElem);
        }
    }
}
