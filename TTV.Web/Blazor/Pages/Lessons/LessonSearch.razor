@using Fluxor;
@using TTV.Web.Blazor.Store.Lessons;
@using TTV.Web.Blazor.Store.Lessons.Actions;
@inherits Fluxor.Blazor.Web.Components.FluxorComponent

<div class="form-group d-flex mb-3">
    <div class="form-floating flex-fill me-2">
        <input type="text" class="form-control" id="lesson-search-text" @bind="searchText" @bind:event="oninput" @onkeypress="KeyPressed" placeholder="Search lessons..." disabled="@LessonsState.Value.IsLoadingLessons" />
        <label for="lesson-search-text">Search lessons...</label>
    </div>
    <button class="btn btn-outline-primary" @onclick="SearchClicked" disabled="@LessonsState.Value.IsLoadingLessons">
        @if (LessonsState.Value.IsLoadingLessons)
        {
            <SpinLoader IsLoading="LessonsState.Value.IsLoadingLessons"></SpinLoader>
        }
        else
        {
            <i class="bi bi-search me-1"></i> <span>Search</span>
        }
    </button>
</div>

@code {
    [Inject]
    private IState<LessonsState> LessonsState { get; set; } = default!;

    [Inject]
    private IDispatcher Dispatcher { get; set; } = default!;

    [Inject]
    private IActionSubscriber ActionSubscriber { get; set; } = default!;

    string? searchText;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        searchText = LessonsState.Value.SearchText;
        ActionSubscriber.SubscribeToAction<SearchLessonsRequest>(this, action => searchText = action.SearchText);
    }

    private void KeyPressed(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SearchClicked();
        }
    }

    private void SearchClicked()
    {
        Dispatcher.Dispatch(new SearchLessonsRequest() { SearchText = searchText, SearchTags = LessonsState.Value.SearchTags });
    }

    protected override void Dispose(bool disposing)
    {
        ActionSubscriber.UnsubscribeFromAllActions(this);
        base.Dispose(disposing);
    }
}
