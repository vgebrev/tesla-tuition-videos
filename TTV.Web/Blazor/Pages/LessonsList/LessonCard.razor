@using TTV.Web.Shared;
<div class="card border-primary">
    <div class="card-header bg-secondary"><h5 class="card-title text-center mb-0">@Lesson.Title</h5></div>
    <div class="card-body">
        <p class="card-text">@Lesson.Description</p>
        <TagBadges Tags="Lesson.Tags"></TagBadges>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <a href="lesson/@Lesson.Id" class="card-link">View Lesson</a>
        <AuthorizeView>
            <Authorized>
                @if (context.User.FindFirst("sub")?.Value != Lesson.Owner?.Id.ToString())
                {
                    <a href="#" class="card-link">Buy Now for <PriceDisplay Price="Lesson.CurrentPrice"></PriceDisplay></a>
                } 
                else
                {
                    <span class="text-primary text-sm">You own this lesson</span>   
                }
            </Authorized>
            <NotAuthorized>
                <a href="#" class="card-link">Buy Now for <PriceDisplay Price="Lesson.CurrentPrice"></PriceDisplay></a>
            </NotAuthorized>
        </AuthorizeView>

    </div>
</div>

@code {
    [Parameter]
    public LessonDto Lesson { get; set; } = new();
}
