@using Fluxor;
@using TTV.Web.Blazor.Pages.LessonsList.Store;
@using TTV.Web.Blazor.Pages.LessonsList.Store.Actions;
@using TTV.Web.Shared;

@inherits Fluxor.Blazor.Web.Components.FluxorComponent;

<div class="card text-white bg-secondary">
    <div class="card-header"><i class="bi bi-sliders"></i> Filters</div>
    <div class="card-body">
        @if (IsLoading)
        {
            <ProgressLoader IsLoading="IsLoading"></ProgressLoader>
        }
        <ErrorCard Error="LessonsState.Value.TagsError"></ErrorCard>
        @if (Tags != null)
        {
            <div class="d-flex justify-content-between">
                <button type="button" class="btn btn-sm btn-outline-primary m-1" @onclick="ApplyFilter"><i class="bi bi-check me-1"></i> Apply</button>
                <button type="button" class="btn btn-sm btn-outline-primary m-1" @onclick="ClearFilter"><i class="bi bi-x me-1"></i> Clear</button>
            </div>
            foreach (var categoryGroup in Tags.GroupBy(t => t.Category))
            {
                <h5 class="card-title">@categoryGroup.Key.Name</h5>
                <ul class="list-group list-group-flush">
                    @foreach (var tag in categoryGroup)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" checked="@IsChecked(tag)" @onchange="(e) => TagToggled(e, tag)" id="filter-item-@tag.Id">
                                <label class="form-check-label" for="filter-item-@tag.Id">@tag.Name</label>
                            </div>
                            <span class="badge bg-primary rounded-pill">@tag.LessonCount</span>
                        </li>
                    }
                </ul>
            }
        }
    </div>
</div>

@code {
    [Inject]
    private IState<LessonsListState> LessonsState { get; set; } = default!;
    [Inject]
    private IDispatcher Dispatcher { get; set; } = default!;

    private bool IsLoading => LessonsState.Value.IsLoadingTags;
    private TagDto[]? Tags => LessonsState.Value.Tags;
    private bool IsChecked(TagDto tag) => LessonsState.Value.SearchTags?.Contains(tag) ?? false;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (LessonsState.Value.Tags == null)
        {
            Dispatcher.Dispatch(new GetTagsRequest());
        }
    }

    private void TagToggled(ChangeEventArgs e, TagDto toggledTag)
    {
        bool isChecked = (bool)(e.Value ?? false);

        var searchTags = new List<TagDto>(LessonsState.Value.SearchTags ?? Array.Empty<TagDto>());

        if (!searchTags.Contains(toggledTag) && isChecked)
        {
            searchTags.Add(toggledTag);
        }

        if (searchTags.Contains(toggledTag) && !isChecked)
        {
            searchTags.Remove(toggledTag);
        }

        Dispatcher.Dispatch(new SetSearchTags() { SearchTags = searchTags.ToArray() });
    }

    private void ApplyFilter()
    {
        var tags = Tags?.Where(IsChecked).ToArray();
        Dispatcher.Dispatch(new SearchLessonsRequest() { SearchText = LessonsState.Value.SearchText, SearchTags = tags });
    }

    private void ClearFilter()
    {
        Dispatcher.Dispatch(new SearchLessonsRequest() { SearchText = null, SearchTags = null });
    }
}
