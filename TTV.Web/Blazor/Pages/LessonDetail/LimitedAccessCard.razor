@using System.Security.Claims;
@using TTV.Web.Shared;
<LessonOwnView Lesson="Lesson">
    <NotOwned>
        <div class="card border-warning mb-3">
            <div class="card-body d-flex align-items-center flex-wrap">
                <span class="card-text">Limited access. Please purchase the lesson for full access. </span>
                <BuyNowButton Lesson="Lesson" class="mx-2 my-2 my-md-0 btn btn-outline-warning flex-grow-1"></BuyNowButton>
                <AuthorizeView>
                    <NotAuthorized>
                        <span class="card-text">If you have already purchased the lesson, please <LogInLink class="text-warning">Log in</LogInLink>.</span>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </NotOwned>
</LessonOwnView>

@code {
    [Parameter]
    public LessonDto Lesson { get; set; } = new();
}
