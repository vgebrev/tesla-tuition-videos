@using System.ComponentModel.DataAnnotations
@using Fluxor;
@using TTV.Web.Blazor.Pages.My.DiscountVouchers.Actions;
@using TTV.Web.Blazor.Pages.My.DiscountVouchers.Store;
@using TTV.Web.Shared;

@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IState<MyDiscountVouchersState> State
@inject IDispatcher Dispatcher

<AuthorizeView Context="AuthContext">
    <Authorized>
        <div class="row">
            <div class="card-text">
                @if (DiscountVouchers != null && DiscountVouchers.Length > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Amount</th>
                                    <th>Balance</th>
                                    <th>Expires</th>
                                    <th>Issued</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < DiscountVouchers.Length; i++)
                                {
                                    var voucher = DiscountVouchers[i];
                                    <tr class="@(i % 2 == 0 ? "table-secondary": "")">
                                        <td>@voucher.Code</td>
                                        <td>R@(voucher.Amount.ToString("0"))</td>
                                        <td>R@(voucher.Balance.ToString("0"))</td>
                                        <td nowrap class="@(voucher.ExpirationDate < DateOnly.FromDateTime(DateTime.Today) ? "text-warning" : "")">
                                            @if (voucher.ExpirationDate != null)
                                            {
                                                @voucher.ExpirationDate.Value.ToString("dd-MMM-yyyy")
                                            }
                                            else
                                            {
                                                <span class="text-muted">Never</span>
                                            }
                                        </td>
                                        <td nowrap>@voucher.IssuedAt.ToString("dd-MMM-yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (!State.Value.IsLoading)
                {
                    <div class="row">
                        <div class="col text-center">
                            We didn't find any vouchers in your name.
                            <a href="contact-us" title="Contact us" class="card-link">Contact us</a> to find out more.
                        </div>
                    </div>
                }
            </div>
        </div>
    </Authorized>
</AuthorizeView>
@code {
    private DiscountVoucherDto[]? DiscountVouchers => State.Value.DiscountVouchers;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Dispatcher.Dispatch(new GetDiscountVouchersRequest());
    }
}
