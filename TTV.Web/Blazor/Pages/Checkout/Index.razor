@page "/checkout/{orderId:int}"
@attribute [Authorize]

@using Fluxor;
@using Microsoft.AspNetCore.Authorization;
@using System.ComponentModel.DataAnnotations;
@using TTV.Web.Blazor.Pages.Checkout.Store;
@using TTV.Web.Blazor.Pages.Checkout.Store.Actions;
@using TTV.Web.Shared

@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IState<CheckoutState> State
@inject IDispatcher Dispatcher

<PageTitle>Tesla Tuition Videos - Checkout</PageTitle>

<div class="row justify-content-center">
    <div class="col text-center">
        <h1 class="header-white">Checkout</h1>
    </div>
</div>

@if (IsLoading)
{
    <ProgressLoader IsLoading="IsLoading" class="mb-3"></ProgressLoader>
}

@if (Order != null)
{
    <div class="row">
        <div class="col-lg-6 col-sm-12 mb-3">
            <div class="row">
                <div class="col-12 mb-3">
                    <OrderDetail Order="Order"></OrderDetail>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <ApplyDiscountVoucher></ApplyDiscountVoucher>
                </div>
            </div>
        </div>
        <div class="col-lg-6 col-sm-12">
            <PaymentDetail OrderId="Order.Id"></PaymentDetail>
        </div>
    </div>

    @if (Order.CanCheckout)
    {
        <div class="row justify-content-center m-3">
            <div class="col-3 text-center">
                <button type="button" class="btn btn-secondary btn-lg" @onclick="CancelOrder"><i class="bi bi-x me-2"></i> Cancel</button>
            </div>
            @if (Order.TotalAmount <= 0)
            {
                <div class="col-3 text-center">
                    <button type="button" class="btn btn-primary btn-lg" @onclick="CompleteOrder"><i class="bi bi-hand-thumbs-up me-2"></i> Complete</button>
                    <ResultCard Result="CompleteOrderResult"></ResultCard>
                </div>
            }
            else
            {
                <div class="col-3 text-center">
                    <button type="button" class="btn btn-primary btn-lg" @onclick="OrderPayment"><i class="bi bi-credit-card me-2"></i> Payment</button>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="card border-warning m-3">
                <div class="card-body">
                    No further action is possible on orders with a status of "@(Order.Status.Name)"
                </div>
            </div>
        </div>
    }
}
else if (!IsLoading && !Error.IsError)
{
    <div class="row justify-content-center">
        <div class="card border-warning">
            <div class="card-body">
                Order #@OrderId not found.
            </div>
        </div>
    </div>
}

@if (Error.IsError)
{
    <ErrorCard Error="Error"></ErrorCard>
}

@code {
    [Parameter]
    public int OrderId { get; set; }

    private OrderDto? Order => State.Value.Order;
    private bool IsLoading => State.Value.IsLoading;
    private ErrorState Error => State.Value.Error;

    private ResultDto<OrderDto>? CompleteOrderResult => State.Value.CompleteOrderResult;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        Dispatcher.Dispatch(new GetOrderRequest() { OrderId = OrderId, CurrentOrder = Order });
    }

    private void CancelOrder()
    {
        // TODO: Order payment
    }

    private void CompleteOrder()
    {
        Dispatcher.Dispatch(new CompleteOrderRequest() { OrderId = OrderId });
    }

    private void OrderPayment()
    {
        // TODO: Order payment
    }
}
