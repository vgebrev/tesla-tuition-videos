@page "/lessons"
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication;
@using TTV.Web.Shared;
@inject HttpClient Http

<PageTitle>Tesla Tuition Videos - Lessons</PageTitle>

<div class="row justify-content-center">
    <div class="col text-center">
        <h1 class="header-white">Lessons</h1>
    </div>
</div>

<div class="row">
    <div class="col-3">
        <TagFilter></TagFilter>
    </div>
    <div class="col">
        <div class="row">
            <div class="col-12">
                <LessonSearch></LessonSearch>
            </div>
        </div>

        <div class="row row-cols-2 g-3">
            @if (lessons == null)
            {
                <div class="col text-center">
                    <SpinLoader IsLoading="true"></SpinLoader>
                </div>
            }
            else
            {
                @foreach (var lesson in lessons)
                {
                    <div class="col">
                        <LessonCard Lesson="lesson"></LessonCard>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private LessonDto[]? lessons;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            lessons = await Http.GetFromJsonAsync<LessonDto[]>("api/Lesson");
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
    }
}
