@page "/lesson/{lessonId:int}"

@using Fluxor;
@using TTV.Web.Shared
@using TTV.Web.Blazor.Pages.LessonDetail.Store
@using TTV.Web.Blazor.Pages.LessonDetail.Store.Actions

@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IState<LessonDetailState> State
@inject IDispatcher Dispatcher

<PageTitle>@Title</PageTitle>

@if (IsLoading)
{
    <ProgressLoader IsLoading="IsLoading"></ProgressLoader>
}

@if (Error.IsError)
{
    <ErrorCard Error="Error"></ErrorCard>
}

@if (Lesson != null)
{
    <div class="card border-primary">
        <div class="card-header bg-secondary"><h5 class="card-title text-center mb-0">@Lesson.Title</h5></div>
        <div class="card-body">
            <LimitedAccessCard Lesson="Lesson"></LimitedAccessCard>
            <LessonVideoPlayer LessonId="Lesson.Id"></LessonVideoPlayer>
            <p class="card-text">@Lesson.Description</p>
            <TagBadges Tags="Lesson.Tags"></TagBadges>
        </div>
        <div class="card-footer">
            @if (Documents != null && Documents.Length > 0)
            {
                <h6 class="card-subtitle">Additional Lesson Resources:</h6>
                @foreach (var document in State.Value.Documents)
                {
                    <DocumentLink Document
                    ="document"></DocumentLink>
                }
            }
        </div>
    </div>
}
else if (!IsLoading && !Error.IsError)
{
    <div class="row justify-content-center">
        <div class="card border-warning col-12 col-md-8 col-xl-6">
            <div class="card-body">
                Lesson #@LessonId not found.
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int LessonId { get; set; }

    private bool IsLoading => State.Value.IsLoading;
    private LessonDto? Lesson => State.Value.Lesson;
    private ErrorState Error => State.Value.Error;
    private DocumentDto[] Documents => State.Value.Documents;

    private string Title => $"Tesla Tuition Videos {(Lesson != null ? $" - {Lesson.Title}" : string.Empty)}";

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        Dispatcher.Dispatch(new GetLessonRequest() { LessonId = LessonId });
        Dispatcher.Dispatch(new GetDocumentsRequest() { LessonId = LessonId });
    }
}
