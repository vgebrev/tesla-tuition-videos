# Copy to .env for local development. All variables are read via
# $env/dynamic/public in src/lib/config.js and must be prefixed PUBLIC_.

# Backend endpoints. These ports are load-bearing: the API and Auth
# launchSettings.json profiles bind them, and the seeded IdentityServer client
# hard-codes https://localhost:5173 as its redirect origin.
PUBLIC_OIDC_AUTHORITY="https://localhost:5001"
PUBLIC_API_BASEURL="https://localhost:5002"

# Site-wide announcement banner. ACTIVE is compared as the string 'true'.
PUBLIC_ANNOUNCEMENT_ACTIVE="false"
PUBLIC_ANNOUNCEMENT_ID="dev-announcement"
PUBLIC_ANNOUNCEMENT_TITLE="Tesla Tuition Videos"
PUBLIC_ANNOUNCEMENT_MESSAGE="Announcement message"
PUBLIC_ANNOUNCEMENT_ENDDATE="2026-12-31T23:59:59"

# Shows the test-environment banner. Also compared as the string 'true'.
PUBLIC_ISTESTENVIRONMENT="true"

# Manual bank-transfer payment details shown at checkout.
PUBLIC_BANKACCOUNT_BANKNAME="ACME Bank"
PUBLIC_BANKACCOUNT_ACCOUNTNUMBER="1234567890"
PUBLIC_BANKACCOUNT_BRANCHCODE="123456"
