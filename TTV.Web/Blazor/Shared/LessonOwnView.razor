@using TTV.Web.Shared;
<AuthorizeView>
    <Authorized>
        @if (Lesson.IsFree)
        {
            @Free
        } 
        else if ((context.User.FindFirst("sub")?.Value ?? string.Empty) == Lesson.Owner?.Id.ToString())
        {
            @Owned
        }
        else
        {
            @NotOwned
        }
    </Authorized>
    <NotAuthorized>
        @if (Lesson.IsFree)
        {
            @Free
        }
        else
        {
            @NotOwned
        }
    </NotAuthorized>
</AuthorizeView>
@code {
    [Parameter]
    public LessonDto Lesson { get; set; } = new();

    [Parameter]
    public RenderFragment? Owned { get; set; }

    [Parameter]
    public RenderFragment? NotOwned { get; set; }

    [Parameter]
    public RenderFragment? Free { get; set; }
}
