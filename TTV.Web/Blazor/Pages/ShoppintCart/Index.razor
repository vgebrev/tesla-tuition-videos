@page "/shopping-cart"

@using Fluxor;
@using TTV.Web.Blazor.Pages.ShoppintCart.Store
@using TTV.Web.Blazor.Pages.ShoppintCart.Store.Actions;
@using TTV.Web.Shared

@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IState<ShoppingCartState> State;
@inject IDispatcher Dispatcher;

<PageTitle>Tesla Tuition Videos - Shopping Cart</PageTitle>

@if (IsLoading)
{
    <ProgressLoader IsLoading="IsLoading"></ProgressLoader>
}

<div class="row justify-content-center">
    <div class="col text-center">
        <h1 class="header-white">Shopping Cart</h1>
    </div>
</div>
<div class="row justify-content-center">
    <div class="card border-primary w-75">
        <div class="card-body">
            @if (Lessons.Length > 0)
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Lesson</th>
                            <th>Price</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Lessons.Length; i++)
                        {
                            var lesson = Lessons[i];
                            <tr class="@(i % 2 == 0 ? "table-secondary" : "") align-middle">
                                <td>@lesson.Title</td>
                                <td><PriceDisplay Price="lesson.CurrentPrice"></PriceDisplay></td>
                                <td class="text-end"><button type="button" class="btn btn-outline-primary" @onclick="() => RemoveLesson(lesson)"><i class="bi bi-trash me-1"></i> Remove</button></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th class="text-end">Total</th>
                            <th>R@(Lessons.Sum(lesson => lesson.CurrentPrice.PromoAmount ?? lesson.CurrentPrice.Amount).ToString("0"))</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            }
            else
            {
                <div class="row">
                    <div class="col text-center">
                        Your shopping cart is empty.
                        <a href="lessons" class="card-link">Find some lessons.</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (Lessons.Length > 0)
{
    <div class="row justify-content-center m-3">
        <div class="col-3 text-center">
            <AuthorizeView>
                <NotAuthorized>
                    <LogInLink class="btn btn-primary btn-lg"><i class="bi bi-person-fill me-2"></i> Log in to continue</LogInLink>
                </NotAuthorized>
                <Authorized>
                    <button type="button" class="btn btn-primary btn-lg" disabled="@(Lessons.Length == 0)" @onclick="ConfirmOrder"><i class="bi bi-check2-circle me-2"></i> Confirm and checkout</button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
}

@if (Error.IsError)
{
    <ErrorCard Error="Error"></ErrorCard>
}

@code {
    private bool IsLoading => State.Value.IsLoading;
    private LessonDto[] Lessons => State.Value.Lessons;
    private ErrorState Error => State.Value.Error;

    private void RemoveLesson(LessonDto lesson)
    {
        Dispatcher.Dispatch(new RemoveLesson() { Lesson = lesson });
        Dispatcher.Dispatch(new LocalStorePersistRequest() { Lessons = Lessons });
    }

    public void ConfirmOrder()
    {
        Dispatcher.Dispatch(new ConfirmOrderRequest() { Lessons = Lessons });
    }
}
