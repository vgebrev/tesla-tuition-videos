@using Microsoft.AspNetCore.Components.WebAssembly.Authentication;
@using Microsoft.Extensions.Options;

@inject IOptionsSnapshot<LocalConfig> Config
@inject IAccessTokenProvider TokenProvider

<video oncontextmenu="return false;" controls controlslist="nodownload" class="w-100">
    <source src="@VideoUri" type="video/mp4" />
</video>

@code {
    [Parameter]
    public int LessonId { get; set; }

    private string VideoUri { get; set; } = string.Empty;
    private string AccessToken { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        VideoUri = $"{Config.Value.ApiRootUri}/api/video/{LessonId}";
        var accessTokenResult = await TokenProvider.RequestAccessToken();
        if (accessTokenResult.TryGetToken(out var token))
        {
            VideoUri += $"?access_token={token.Value}";
        }
    }
}
