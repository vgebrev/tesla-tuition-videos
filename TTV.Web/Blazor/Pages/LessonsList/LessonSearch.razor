@using Fluxor;
@using TTV.Web.Blazor.Pages.LessonsList.Store;
@using TTV.Web.Blazor.Pages.LessonsList.Store.Actions;

@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IState<LessonsListState> State
@inject IDispatcher Dispatcher
@inject IActionSubscriber ActionSubscriber

<div class="form-group d-flex">
    <div class="form-floating flex-fill me-2">
        <input type="text" class="form-control" id="lesson-search-text" @bind="searchText" @bind:event="oninput" @onkeypress="KeyPressed" placeholder="Search lessons..." />
        <label for="lesson-search-text">Search lessons</label>
    </div>
    <button class="btn btn-outline-primary" @onclick="SearchClicked">
        <i class="bi bi-search me-1"></i> <span>Search</span>
    </button>
</div>

@code {
    string? searchText;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        searchText = State.Value.SearchText;
        ActionSubscriber.SubscribeToAction<SearchLessonsRequest>(this, action => searchText = action.SearchText);
    }

    private void KeyPressed(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SearchClicked();
        }
    }

    private void SearchClicked()
    {
        Dispatcher.Dispatch(new SearchLessonsRequest() { SearchText = searchText, SearchTags = State.Value.SearchTags });
    }

    protected override void Dispose(bool disposing)
    {
        ActionSubscriber.UnsubscribeFromAllActions(this);
        base.Dispose(disposing);
    }
}
