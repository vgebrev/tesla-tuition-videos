@using Fluxor;
@using Microsoft.Extensions.Options;
@using TTV.Web.Shared;
@inject IOptionsSnapshot<LocalConfig> Config
@inject NavigationManager Navigation

<div class="card border-primary h-100">
    <div class="card-header bg-secondary">
        <div class="d-flex justify-content-between">
            <h5 class="card-title text-center mb-0">Order #@Order.Id (@Order.Status.Name)</h5>
            <small class="text-muted">@Order.PlacedOn.ToString("dd-MMM-yyyy")</small>
        </div>
    </div>
    <div class="card-body">
        @foreach (var lesson in Order.Lessons)
        {
            <div class="row align-items-start mb-2">
                <div class="col-3 text-end">
                    <a href="/lesson/@lesson.Id"><img class="rounded-2 icon-lg" src="@ThumbnailUri(lesson.Id)" alt="@lesson.Title" title="@lesson.Title" /></a>
                </div>
                <div class="col-6">
                    <small>
                        <a href="/lesson/@lesson.Id">@lesson.Title</a>
                    </small>
                </div>
                <div class="col-3">
                    R@(lesson.CurrentPrice.EffectiveAmount.ToString("0"))
                </div>
            </div>
        }
        <div class="row">
            <div class="col-9 text-end"><strong>Total</strong></div>
            <div class="col-3"><strong>R@(Order.Lessons.Sum(lesson => lesson.CurrentPrice.EffectiveAmount).ToString("0"))</strong></div>
        </div>
        <div class="row">
            <div class="col-9 text-end"><strong>Outstanding</strong></div>
            <div class="col-3"><strong>R@(Order.TotalAmount.ToString("0"))</strong></div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-baseline">
        @if (!Order.IsFinalised)
        {
            <button type="button" class="btn btn-outline-primary" @onclick="CheckoutOrder"><i class="bi bi-arrow-right-circle me-2"></i> Continue</button>
        }
    </div>
</div>


@code {
    [Parameter]
    public OrderDto Order { get; set; } = new();

    private string ThumbnailUri(int lessonId) => $"{Config.Value.ApiRootUri}/videos/lesson/{lessonId}/thumbnail";

    private void CheckoutOrder()
    {
        Navigation.NavigateTo($"checkout/{Order.Id}");
    }
}
