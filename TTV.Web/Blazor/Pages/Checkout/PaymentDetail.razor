@attribute [Authorize]

@using Fluxor;
@using Microsoft.AspNetCore.Authorization
@using TTV.Web.Blazor.Pages.Checkout.Store;
@using TTV.Web.Blazor.Pages.Checkout.Store.Actions;
@using TTV.Web.Shared

@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IState<CheckoutState> State
@inject IDispatcher Dispatcher

<div class="card bg-secondary">
    <div class="card-header">Payment Details</div>
    <div class="card-body">
        <h4>Payment Method</h4>
        <EditForm Model="paymentMethod" class="border-1 border-bottom border-dark mb-3">
            <div class="row">
                <InputRadioGroup @bind-Value="paymentMethod">
                    <div class="col-12 col-md-4 mb-2">
                        <div class="form-check">
                            <InputRadio class="form-check-input" id="eft" Value="PaymentMethod.BankTransfer" />
                            <label class="form-check-label" for="eft">
                                <i class="bi bi-bank"></i> Bank Transfer
                            </label>
                        </div>
                    </div>
                    <div class="col-12 col-md-4 mb-2">
                        <div class="form-check disabled">
                            <InputRadio class="form-check-input" id="credit-card" Value="PaymentMethod.CreditCard" disabled />
                            <label class="form-check-label" for="credit-card">
                                <i class="bi bi-credit-card"></i> Credit Card <span class="text-muted">(Coming Soon)</span>
                            </label>
                        </div>
                    </div>
                    <div class="col-12 col-md-4 mb-2">
                        <div class="form-check disabled">
                            <InputRadio class="form-check-input" id="paypal" Value="PaymentMethod.PayPal" disabled />
                            <label class="form-check-label" for="paypal">
                                <i class="bi bi-paypal"></i> PayPal <span class="text-muted">(Coming Soon)</span>
                            </label>
                        </div>
                    </div>
                </InputRadioGroup>
            </div>
        </EditForm>
        @if (paymentMethod == PaymentMethod.BankTransfer)
        {
            <PayByBankTransfer OrderId="@Order.Id"></PayByBankTransfer>
        }
    </div>
    <div class="card-footer">
        <div class="row justify-content-center">
            @if (Order.CanComplete)
            {
                <div class="col-12 col-sm-6 col-md-4 text-center mb-2">
                    <button type="button" class="btn btn-primary btn-lg" @onclick="CompleteOrder"><i class="bi bi-hand-thumbs-up me-2"></i> Complete</button>
                </div>
            }

            @if (Order.IsPayable)
            {
                <div class="col-12 col-sm-6 col-md-4 text-center mb-2">
                    <button type="button" class="btn btn-primary btn-lg" @onclick="OrderPayment"><i class="bi bi-credit-card me-2"></i> Payment</button>
                </div>
            }
        </div>

        <div class="row">
            <div class="col-12 mb-2">
                <ResultCard Result="CompleteOrderResult"></ResultCard>
            </div>
            @if (!Order.CanComplete && !Order.IsPayable && (CompleteOrderResult == null || !CompleteOrderResult.IsSuccess))
            {
                <div class="col-12">
                    @if (Order.HasOwnedLessons)
                    {
                        <div class="card border-danger mb-2">
                            <div class="card-body">
                                You already own one or more of the lessons in this order.
                            </div>
                        </div>
                    }
                    @if (Order.IsFinalised)
                    {
                        <div class="card border-danger">
                            <div class="card-body">
                                The order already has a status of "@Order.Status.Name"
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public OrderDto Order { get; set; } = new();

    private ResultDto<OrderDto>? CompleteOrderResult => State.Value.CompleteOrderResult;

    private PaymentMethod paymentMethod;

    private void CompleteOrder()
    {
        Dispatcher.Dispatch(new CompleteOrderRequest() { OrderId = Order.Id });
    }

    private void OrderPayment()
    {
        // TODO: Order payment
    }

    public enum PaymentMethod
    {
        BankTransfer,
        CreditCard,
        PayPal
    }
}
