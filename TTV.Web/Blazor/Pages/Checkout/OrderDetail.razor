@attribute [Authorize]

@using Fluxor;
@using Microsoft.AspNetCore.Authorization
@using TTV.Web.Blazor.Pages.Checkout.Store
@using TTV.Web.Blazor.Pages.Checkout.Store.Actions;
@using TTV.Web.Shared

@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IState<CheckoutState> State
@inject IDispatcher Dispatcher

@if (Order != null)
{
    <div class="card bg-secondary">
        <div class="card-header">Order #@Order.Id Details</div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Order.Lessons.Length; i++)
                    {
                        var lesson = Order.Lessons[i];
                        <tr>
                            <td>
                                @lesson.Title
                                @if (UserOwnsLesson(lesson))
                                {
                                    <small class="text-danger"> (You already own this lesson)</small>
                                }
                            </td>
                            <td>R@(lesson.CurrentPrice.EffectiveAmount.ToString("0"))</td>
                        </tr>
                    }
                    <tr class="table-secondary border-primary border-bottom border-1">
                        <th class="text-end">Sub Total</th>
                        <th>R@(Order.Lessons.Sum(l => l.CurrentPrice.EffectiveAmount).ToString("0"))</th>
                    </tr>
                </tbody>
                @if (Order.Payments.Where(p => p.Status.Name == "Paid").Any())
                {
                    <tbody>
                        @foreach (var payment in Order.Payments.Where(p => p.Status.Name == "Paid"))
                        {
                            <tr>
                                <td>@payment.PaymentMethod.ToDisplayString() Payment</td>
                                <td>-R@(payment.Amount.ToString("0"))</td>
                            </tr>
                        }
                        <tr class="table-secondary border-primary border-bottom border-1">
                            <th class="text-end">Sub Total</th>
                            <th>-R@(Order.Payments.Where(p => p.Status.Name == "Paid").Sum(d => d.Amount).ToString("0"))</th>
                        </tr>
                    </tbody>
                }
                @if (Order.AppliedDiscounts.Length > 0)
                {
                    <tbody>
                        @for (int i = 0; i < Order.AppliedDiscounts.Length; i++)
                        {
                            var discount = Order.AppliedDiscounts[i];
                            <tr>
                                <td>Discount Voucher (@discount.VoucherCode)</td>
                                <td>-R@(discount.Amount.ToString("0"))</td>
                            </tr>
                        }
                        <tr class="table-secondary border-primary border-bottom border-1">
                            <th class="text-end">Sub Total</th>
                            <th>-R@(Order.AppliedDiscounts.Sum(d => d.Amount).ToString("0"))</th>
                        </tr>
                    </tbody>
                }
                <tfoot>
                    <tr class="table-secondary border-primary border-bottom border-2">
                        <th class="text-end">Total</th>
                        <th>R@(OrderTotal.ToString("0"))</th>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="card-footer row">
            @if (!Order.IsFinalised)
            {
                <div class="col-12 mb-2">
                    <button type="button" class="btn btn-outline-primary" @onclick="CancelOrder"><i class="bi bi-trash me-2"></i> Cancel</button>
                    <small class="text-muted">Applied discount vouchers will be refunded.</small>
                </div>
            }
            @if (CancelOrderResult != null)
            {
                <div class="col-12">
                    <ResultCard Result="CancelOrderResult"></ResultCard>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public OrderDto? Order { get; set; }

    private decimal OrderTotal => Order == null ? 0 : Order.Lessons.Sum(l => l.CurrentPrice.EffectiveAmount) - Order.AppliedDiscounts.Sum(d => d.Amount) - Order.Payments.Where(p => p.Status.Name == "Paid").Sum(p => p.Amount);
    private ResultDto<OrderDto>? CancelOrderResult => State.Value.CancelOrderResult;

    private bool UserOwnsLesson(LessonDto lesson)
    {
        if (Order == null || lesson.Owner == null)
        {
            return false;
        }
        return lesson.Owner.Id == Order.PlacedBy.Id;
    }

    private void CancelOrder()
    {
        if (Order == null)
        {
            return;
        }

        Dispatcher.Dispatch(new CancelOrderRequest() { OrderId = Order.Id });
    }
}
