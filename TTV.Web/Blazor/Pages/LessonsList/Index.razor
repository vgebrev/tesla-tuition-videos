@page "/lessons"

@using Fluxor;
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication;
@using TTV.Web.Blazor.Pages.LessonsList.Store;
@using TTV.Web.Blazor.Pages.LessonsList.Store.Actions;
@using TTV.Web.Shared;

@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IState<LessonsListState> State
@inject IDispatcher Dispatcher

<PageTitle>Tesla Tuition Videos - Lessons</PageTitle>

<div class="row justify-content-center">
    <div class="col text-center">
        <h1 class="header-white">Lessons</h1>
    </div>
</div>

<div class="row">
    <div class="col-3">
        <TagFilter></TagFilter>
    </div>
    <div class="col">
        <div class="row">
            <div class="col-12">
                <LessonSearch></LessonSearch>
            </div>
        </div>
        <div class="row">
            <div class="col-12 my-1 min-height-16">
                <ProgressLoader IsLoading="IsLoading"></ProgressLoader>
            </div>
        </div>
        @if (State.Value.LessonsError.IsError)
        {
            <div class="row">
                <div class="col-7 mb-3 mx-auto">
                    <ErrorCard Error="State.Value.LessonsError"></ErrorCard>
                </div>
            </div>
        }

        @if (State.Value.Lessons != null)
        {
            @if (State.Value.Lessons.Length > 0)
            {
                <div class="row row-cols-2 g-3">

                    @foreach (var lesson in State.Value.Lessons)
                    {
                        <div class="col">
                            <LessonCard Lesson="lesson"></LessonCard>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col text-center">
                        No lessons match your search.
                        <p class="text-muted">Please try again with different search terms or filters.</p>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private bool IsLoading => State.Value.IsLoadingLessons;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (State.Value.Lessons == null)
        {
            Dispatcher.Dispatch(new SearchLessonsRequest() { SearchText = State.Value.SearchText, SearchTags = State.Value.SearchTags });
        }
    }
}
