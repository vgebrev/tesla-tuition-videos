@using TTV.Web.Shared;

@foreach (var tag in Tags)
{
    <span class="badge @GetTagBackground(tag.Priority) mx-1">@tag.Name</span>
}

@code {
    [Parameter]
    public SimpleTagDto[] Tags { get; set; } = Array.Empty<SimpleTagDto>();

    private string GetTagBackground(int priority) => priority switch
    {
        0 => "bg-primary",
        1 => "bg-info",
        2 => "bg-secondary",
        3 => "bg-dark",
        _ => "bg-light"
    };
}
