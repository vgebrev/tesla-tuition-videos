@using Fluxor;
@using TTV.Web.Blazor.Models;
@using TTV.Web.Blazor.Store.Lessons;
@using TTV.Web.Blazor.Store.Lessons.Actions;
@using TTV.Web.Shared;
@inherits Fluxor.Blazor.Web.Components.FluxorComponent;

<div class="card text-white bg-secondary">
    <div class="card-header"><i class="bi bi-sliders"></i> Filters</div>
    <div class="card-body">
        @if (IsLoading)
        {
            <div class="text-center"><SpinLoader IsLoading="IsLoading"></SpinLoader></div>
        }
        @if (CheckItems != null)
        {
            <div class="d-flex justify-content-between">
                <button type="button" class="btn btn-sm btn-outline-primary m-1" @onclick="ApplyFilter"><i class="bi bi-check me-1"></i> Apply</button>
                <button type="button" class="btn btn-sm btn-outline-primary m-1" @onclick="ClearFilter"><i class="bi bi-x me-1"></i> Clear</button>
            </div>
            foreach (var categoryGroup in CheckItems.GroupBy(t => t.Item.Category))
            {
                <h5 class="card-title">@categoryGroup.Key.Name</h5>
                <ul class="list-group list-group-flush">
                    @foreach (var item in categoryGroup)
                    {
                        var tag = item.Item;
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" @bind="item.IsChecked" id="filter-item-@tag.Id">
                                <label class="form-check-label" for="filter-item-@tag.Id">@tag.Name</label>
                            </div>
                            <span class="badge bg-primary rounded-pill">@tag.LessonCount</span>
                        </li>
                    }
                </ul>
            }
        }
    </div>
</div>

@code {
    [Inject]
    private IState<LessonsState> LessonsState { get; set; } = default!;
    [Inject]
    private IDispatcher Dispatcher { get; set; } = default!;
    [Inject]
    private IActionSubscriber ActionSubscriber { get; set; } = default!;

    private bool IsLoading => LessonsState.Value.IsLoadingTags;

    private CheckItem<TagDto>[]? CheckItems { get; set; }


    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (LessonsState.Value.Tags == null)
        {
            Dispatcher.Dispatch(new GetTagsRequest());
        }
        else
        {
            InitCheckItems(LessonsState.Value.Tags);
        }

        ActionSubscriber.SubscribeToAction<GetTagsResponse>(this, (action) => InitCheckItems(action.Tags));
    }

    private void InitCheckItems(TagDto[]? tags)
    {
        CheckItems = tags?.Select(tag => new CheckItem<TagDto>
            {
                Item = tag,
                IsChecked = LessonsState.Value.SearchTags?.Contains(tag) ?? false
            }).ToArray();
    }

    private void ApplyFilter()
    {
        var tags = CheckItems?.Where(x => x.IsChecked).Select(x => x.Item).ToArray();
        Dispatcher.Dispatch(new SearchLessonsRequest() { SearchText = LessonsState.Value.SearchText, SearchTags = tags });
    }

    private void ClearFilter()
    {
        if (CheckItems == null)
            return;

        foreach (var item in CheckItems)
        {
            item.IsChecked = false;
        };
        Dispatcher.Dispatch(new SearchLessonsRequest() { SearchText = LessonsState.Value.SearchText, SearchTags = null });
    }

    protected override void Dispose(bool disposing)
    {
        ActionSubscriber.UnsubscribeFromAllActions(this);
        base.Dispose(disposing);
    }
}
