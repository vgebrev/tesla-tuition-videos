@page
@model             TTV.Web.Auth.Pages.Index

<div class="welcome-page">
    <div class="row justify-content-center">
        <div class="col text-center">
            <h1 class="text-white">Security Service</h1>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="card border-primary col">
            <div class="card-body">
                <div class="row">
                    <div class="col m-3 text-center">
                        <p class="fs-5">You've reached our security service that helps us manage and verify your identity, lets you log in and access our application safely.</p>
                    </div>
                </div>
                <div class="row">
                    <div class="col m-3 text-center">
                        <div class="fs-5">
                            There's not much for you to do here right now. Please head back to <a href="@Model.ClientUri">@Model.ClientName</a> to continue your journey.
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col m-3 text-center">
                        <div class="fs-6">
                            Powered by <img src="~/duende-logo.svg" class="logo"> <a href="https://duendesoftware.com/products/identityserver" title="Duende IdentityServer">Duende IdentityServer</a> <small class="text-muted">(version @Model.Version)</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
