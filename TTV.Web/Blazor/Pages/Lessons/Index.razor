@page "/lessons"
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication;
@using TTV.Web.Shared;
@inject HttpClient Http

<PageTitle>Tesla Tuition Videos - Lessons</PageTitle>

<h1>Lessons</h1>

@if (lessons == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Type</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var lesson in lessons)
            {
                <tr>
                    <td>@lesson.Title</td>
                    <td>@lesson.Description</td>
                    <td>@lesson.LessonType.Name</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private LessonDto[]? lessons;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            lessons = await Http.GetFromJsonAsync<LessonDto[]>("api/Lesson");
        }
        catch (AccessTokenNotAvailableException exception)
        {
            exception.Redirect();
        }
    }
}
