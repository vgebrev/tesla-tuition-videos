{
  "Cors": {
    "AllowedOrigins": [ "https://localhost:5003", "https://localhost:5173" ]
  },
  "IdentityServerSettings": {
    "IdentityResources": [
      {
        "Name": "openid",
        "IsBuiltIn": true,
        "BuiltInType": "OpenId"
      },
      {
        "Name": "profile",
        "IsBuiltIn": true,
        "BuiltInType": "Profile"
      },
      {
        "Name": "email",
        "IsBuiltIn": true,
        "BuiltInType": "Email"
      },
      {
        "Name": "role",
        "DisplayName": "Your roles and permissions",
        "ShowInDiscoveryDocument": true,
        "UserClaims": [ "role", "permission" ]
      }
    ],
    "ApiScopes": [
      {
        "Name": "ttv_web_api",
        "DisplayName": "Tesla Tuition Videos API",
        "UserClaims": [ "email", "sub", "role", "permission" ]
      }
    ],
    "Clients": [
      {
        "ClientId": "ttv_web_frontend",
        "ClientName": "Tesla Tuition Videos",
        "RequireClientSecret": false,
        "AllowedGrantTypes": [ "authorization_code", "client_credentials" ],
        "RedirectUris": [ "https://localhost:5173/authentication/login-callback" ],
        "PostLogoutRedirectUris": [ "https://localhost:5173/authentication/logout-callback" ],
        "AllowOfflineAccess": true,
        "AllowedScopes": [ "openid", "profile", "email", "ttv_web_api" ]
      }
    ],
    "Roles": [
      {
        "Name": "admin",
        "Claims": [
          {
            "Type": "permission",
            "Value": "vouchers.issue"
          }
        ]
      }
    ],
    "Users": [
      {
        "UserName": "admin@example.com",
        "Email": "admin@example.com",
        "Password": "SecurePassword123!",
        "EmailConfirmed": true,
        "Claims": [
          {
            "Type": "name",
            "Value": "Admin User"
          },
          {
            "Type": "given_name",
            "Value": "Admin"
          },
          {
            "Type": "family_name",
            "Value": "User"
          }
        ],
        "Roles": [ "admin" ]
      },
      {
        "UserName": "demo@example.com",
        "Email": "demo@example.com",
        "Password": "SecurePassword123!",
        "EmailConfirmed": true,
        "Claims": [
          {
            "Type": "name",
            "Value": "Demo User"
          },
          {
            "Type": "given_name",
            "Value": "Demo"
          },
          {
            "Type": "family_name",
            "Value": "User"
          }
        ],
        "Roles": [ "admin" ]
      }
    ]
  }
}