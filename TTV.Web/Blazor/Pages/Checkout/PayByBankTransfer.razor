@using Microsoft.Extensions.Options;
@inject IOptionsSnapshot<LocalConfig> LocalConfig

<p>To complete your order, please make a desposit to the following account:</p>

<div class="bg-dark p-2 mb-2">
    <div class="row">
        <div class="col-4">Bank:</div>
        <div class="col-8"><strong>@LocalConfig.Value.BankAccount.BankName</strong></div>
    </div>
    <div class="row">
        <div class="col-4">Account Number:</div>
        <div class="col-8"><strong>@LocalConfig.Value.BankAccount.AccountNumber</strong></div>
    </div>
    <div class="row">
        <div class="col-4">Branch Code:</div>
        <div class="col-8"><strong>@LocalConfig.Value.BankAccount.BranchCode</strong></div>
    </div>
</div>

<p>
    <small>
        Please include your order number <strong>@OrderId</strong> in the reference.
    </small>
</p>
<p>
    <small>
        <strong>NOTE:</strong> It might take up to 2 business days for the deposit to reflect and your order to be completed.
    </small>
</p>
@code {
    [Parameter]
    public int OrderId { get; set; }
}
