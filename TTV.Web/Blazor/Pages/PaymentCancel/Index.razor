@page "/payment-cancel/{orderId:int}"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization;

<PageTitle>Tesla Tuition Videos - Payment Cancelled</PageTitle>

<div class="container">
    <div class="row justify-content-center">
        <div class="col text-center">
            <h1 class="header-white">Payment Cancelled</h1>
        </div>
    </div>
    <div class="row">
        <div class="col text-center">
            The payment for Order #@OrderId was cancelled.
            <a href="/checkout/@OrderId" title="Contact us" class="card-link">Try again.</a>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int OrderId { get; set; }
}
