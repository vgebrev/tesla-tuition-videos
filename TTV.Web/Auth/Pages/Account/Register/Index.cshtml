@page
@model TTV.Web.Auth.Pages.Account.Register.Index

<div class="login-page">
    <div class="row">
        <div class="col-sm-6 mx-auto mb-3">
            <div class="card border-primary">
                <div class="card-header text-primary">
                    Register your account
                </div>

                <div class="card-body text-primary">
                    <form asp-page="/Account/Register/Index">
                        <input type="hidden" asp-for="Input.ReturnUrl" />
                        <div class="form-group mb-3">
                            <label asp-for="Input.Username" class="mb-1"></label> *
                            <input class="form-control" placeholder="E-mail" asp-for="Input.Username" autofocus>
                            <span asp-validation-for="Input.Username" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Input.ConfirmUsername" class="mb-1"></label> *
                            <input class="form-control" placeholder="Confirm E-mail" asp-for="Input.ConfirmUsername" autofocus>
                            <span asp-validation-for="Input.ConfirmUsername" class="text-danger"></span>
                        </div>

                        <div class="form-group my-3">
                            <label asp-for="Input.Password" class="mb-1"></label> *
                            <div class="input-group">
                                <input type="password" class="form-control" placeholder="Password" asp-for="Input.Password" id="password" autocomplete=" off">
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-secondary text-primary"
                                            data-bs-container="body"
                                            data-bs-toggle="popover"
                                            data-bs-placement="right"
                                            data-bs-content="We recommend a long passphrase of random words, or a series of 12 or more characters that don't form a dictionary word, and incorporate lower & upper case letters, digits, and non-alphanumeric characters."
                                            data-bs-original-title="Password recommendation">
                                        <i class="bi-info-circle"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="progress mt-1">
                                <div id="password-strength-bar" class="progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="form-group my-3">
                            <label asp-for="Input.ConfirmPassword" class="mb-1"></label> *
                            <input type="password" class="form-control" placeholder="Confirm Password" asp-for="Input.ConfirmPassword" autocomplete="off">
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>
                        <hr />

                        <div class="form-group my-3">
                            <label asp-for="Input.FirstName" class="mb-1"></label>
                            <input class="form-control" placeholder="First Name" asp-for="Input.FirstName" autocomplete="off">
                            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                        </div>

                        <div class="form-group my-3">
                            <label asp-for="Input.Surname" class="mb-1"></label>
                            <input class="form-control" placeholder="Surname" asp-for="Input.Surname" autocomplete="off">
                            <span asp-validation-for="Input.Surname" class="text-danger"></span>
                        </div>

                        <div class="my-3 d-grid gap-3">
                            <button class="btn btn-primary" name="Input.Button" value="register">Register</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
    @if (Model.View.IsRegistrationSuccessful)
    {
        <div class="row">
            <div class="col-sm-6 mx-auto mb-3">
                <div class="card border-success">
                    <div class="card-header">
                        Success!
                    </div>

                    <div class="card-body" id="success-message">
                        Thank you for registering, you may now <a asp-page="/Account/Login/Index" asp-route-ReturnUrl="@Model.Input.ReturnUrl">login</a>.
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section scripts {
    <script src="~/js/account-register.js" type="text/javascript"></script>
}