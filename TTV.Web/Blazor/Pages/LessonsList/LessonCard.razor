@using TTV.Web.Shared;
<div class="card border-primary h-100">
    <div class="card-header bg-secondary"><h5 class="card-title text-center mb-0">@Lesson.Title</h5></div>
    <div class="card-body">
        <p class="card-text">@Lesson.Description</p>
        <TagBadges Tags="Lesson.Tags"></TagBadges>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-baseline">
        <a href="lesson/@Lesson.Id" class="card-link">View Lesson</a>
        <LessonOwnView Lesson="Lesson">
            <Owned>
                <span class="text-primary text-sm">You own this lesson</span>
            </Owned>
            <NotOwned>
                <BuyNowButton Lesson="Lesson"></BuyNowButton>
            </NotOwned>
        </LessonOwnView>
    </div>
</div>

@code {
    [Parameter]
    public LessonDto Lesson { get; set; } = new();
}
