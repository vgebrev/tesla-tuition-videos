{
  "bracketSameLine": true,
  "bracketSpacing": true,
  "singleAttributePerLine": true,
  "semi": true,
  "useTabs": false,
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 120,
  "plugins": ["prettier-plugin-svelte"],
  "overrides": [{ "files": "*.svelte", "options": { "parser": "svelte" } }]
}
