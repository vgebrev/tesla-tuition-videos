@page "/my/discount-vouchers"
@attribute [Authorize]

@using Fluxor;
@using Microsoft.AspNetCore.Authorization;
@using System.ComponentModel.DataAnnotations;
@using TTV.Web.Blazor.Pages.My.DiscountVouchers.Store;
@using TTV.Web.Shared

@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IState<MyDiscountVouchersState> State
@inject IDispatcher Dispatcher

<PageTitle>Tesla Tuition Videos - My Discount Vouchers</PageTitle>

<div class="row justify-content-center">
    <div class="col text-center">
        <h1 class="header-white">Discount Vouchers</h1>
    </div>
</div>

@if (IsLoading)
{
    <ProgressLoader IsLoading="IsLoading" class="mb-3"></ProgressLoader>
}

<DiscountVouchersList></DiscountVouchersList>

@if (Error.IsError)
{
    <ErrorCard Error="Error"></ErrorCard>
}

@code {
    private bool IsLoading => State.Value.IsLoading;
    public ErrorState Error => State.Value.Error;
}
