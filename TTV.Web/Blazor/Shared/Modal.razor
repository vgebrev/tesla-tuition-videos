@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="modal fade" @ref="element" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content text-bg-dark">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="modal-label">@Title</h1>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="@Id" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @ChildContent
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="@Id">Close</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Id { get; set; } = "modal";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }
    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public string Title { get; set; } = string.Empty;

    private ElementReference element;
    private DotNetObjectReference<Modal>? dotNetObjectReference;
    private IJSObjectReference? script;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && script == null)
        {
            dotNetObjectReference = DotNetObjectReference.Create(this);
            script = await JS.InvokeAsync<IJSObjectReference>("import", "./Shared/Modal.razor.js");
            await script.InvokeVoidAsync("handleModalHidden", element, dotNetObjectReference);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    public async ValueTask DisposeAsync()
    {
        if (script != null)
        {
            await script.DisposeAsync();
        }
    }

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            Open();
        }
        else
        {
            Close();
        }
    }

    [JSInvokable]
    public async Task OnModalHidden()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    public async void Open()
    {
        if (script != null)
            await script.InvokeVoidAsync("openModal", element);
    }

    public async void Close()
    {
        if (script != null)
            await script.InvokeVoidAsync("closeModal", element);
    }
}
